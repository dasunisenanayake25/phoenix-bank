# Phoenix Bank Environment Variables

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_postgres_password
POSTGRES_DB=phoenix_ledger

# Vault
VAULT_ROOT_TOKEN=secure-phoenix-master-token

# JWT Authentication
JWT_SECRET=super_secret_jwt_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key
JWT_REFRESH_EXPIRES_IN=7d

# Kafka
KAFKA_BROKER_URL=kafka:29092
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=accounts-consumer-group

# Backend hardening
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
ENABLE_DEV_SEED=false
TRANSFER_PER_TX_LIMIT_MINOR=5000000
TRANSFER_DAILY_LIMIT_MINOR=50000000
